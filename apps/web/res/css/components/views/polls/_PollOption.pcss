.mx_PollOption {
    border: 1px solid $quinary-content;
    border-radius: 8px;
    padding: 6px 12px;
    background-color: $background;

    .mx_StyledRadioButton_content,
    .mx_PollOption_endedOption {
        padding-top: 2px;
        margin-right: 0px;
    }

    .mx_StyledRadioButton_spacer {
        display: none;
    }
}

.mx_PollOption,
/* label has cursor: default in user-agent stylesheet */
/* override */
.mx_PollOption_live-option {
    cursor: pointer;
}

.mx_PollOption_content {
    display: flex;
    justify-content: space-between;
}

.mx_PollOption_optionVoteCount {
    color: $secondary-content;
    font-size: $font-12px;
    white-space: nowrap;
}

.mx_PollOption_winnerIcon {
    height: 12px;
    width: 12px;
    color: var(--cpd-color-icon-accent-tertiary);
    margin-right: $spacing-4;
    vertical-align: middle;
}

.mx_PollOption_checked {
    .mx_PollOption_popularityBackground {
        .mx_PollOption_popularityAmount {
            background-color: var(--cpd-color-icon-primary);
        }
    }

    /* override checked radio button styling to show checkmark instead */
    .mx_StyledRadioButton_checked {
        input[type="radio"]:checked + div {
            border-color: var(--cpd-color-icon-primary);
            background-color: var(--cpd-color-icon-primary);

            div {
                background: none;

                svg {
                    color: var(--cpd-color-icon-on-solid-primary);
                    width: 12px;
                    height: 12px;
                    margin: -2px;
                    display: block;
                }
            }
        }
    }
}

.mx_PollOption_ended.mx_PollOption_checked {
    .mx_PollOption_popularityBackground {
        .mx_PollOption_popularityAmount {
            background-color: var(--cpd-color-icon-accent-tertiary);
        }
    }

    /* override checked radio button styling to show checkmark instead */
    .mx_StyledRadioButton_checked {
        input[type="radio"]:checked + div {
            border-color: var(--cpd-color-icon-accent-tertiary);
            background-color: var(--cpd-color-icon-accent-tertiary);
        }
    }
}

/* options not actionable in these states (un-vote is handled by a dedicated
   "Undo vote" button rendered next to the totals row, not by clicking the option) */
.mx_PollOption_checked,
.mx_PollOption_ended {
    pointer-events: none;
}

.mx_PollOption_popularityBackground {
    width: 100%;
    height: 8px;
    margin-right: 12px;
    border-radius: 8px;
    background-color: $system;
    margin-top: $spacing-8;

    .mx_PollOption_popularityAmount {
        width: 0%;
        height: 8px;
        border-radius: 8px;
        background-color: var(--cpd-color-icon-primary);
    }
}

.mx_PollOption_voters {
    margin-top: $spacing-8;
    display: flex;
    /* keep clicks on avatars from triggering vote/un-vote on the parent option */
    cursor: default;
    /* parent option may have `pointer-events: none` (checked or ended); the voters
       row must remain interactive for the hover tooltips and the click-to-list menu */
    pointer-events: auto;
}

.mx_PollOption_votersMenu {
    min-width: 220px;
    max-width: 320px;
    max-height: 320px;
    overflow-y: auto;
    padding: $spacing-8 0;
}

.mx_PollOption_votersMenu_title {
    margin: 0;
    padding: $spacing-4 $spacing-12 $spacing-8;
    font-size: $font-12px;
    font-weight: var(--cpd-font-weight-semibold);
    color: $secondary-content;
}

.mx_PollOption_votersMenu_list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.mx_PollOption_votersMenu_person {
    display: flex;
    align-items: center;
    gap: $spacing-8;
    padding: $spacing-4 $spacing-12;
    font-size: $font-14px;
    color: $primary-content;
}

.mx_PollOption_votersMenu_name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
