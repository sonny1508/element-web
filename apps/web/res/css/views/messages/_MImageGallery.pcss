/*
 * _MImageGallery.pcss
 *
 * Styles for the image gallery grid and the bubble wrapper used
 * by ImageGalleryGrouper (both single images and multi-image grids).
 */

// The gallery sits inside a normal EventTile content area.
// Width is driven by the fixed-pixel grid columns set in the component;
// max-width prevents overflow on narrow viewports.
.mx_MImageGallery {
    max-width: 500px;
    overflow: hidden;
}

// -------------------------------------------------------------------------
// Grid container
// -------------------------------------------------------------------------

.mx_MImageGallery_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    border-radius: 8px;
    overflow: hidden;

    // Expanded mode: let rows grow naturally.
    &--expanded {
        grid-template-rows: unset;
        grid-auto-rows: 1fr;

        .mx_MImageGallery_cell {
            aspect-ratio: 1 / 1;
        }
    }
}

// -------------------------------------------------------------------------
// Individual cell
// -------------------------------------------------------------------------

.mx_MImageGallery_cell {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    // Each cell is square so the grid has consistent proportions
    aspect-ratio: 1 / 1;

    .mx_MImageBody {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .mx_MImageBody_thumbnail_container {
        max-width: 100% !important;
        max-height: 100% !important;
        width: 100% !important;
        height: 100% !important;
        aspect-ratio: unset !important;
    }

    // Override the inner sizing <div style={sizing}> that MImageBody
    // wraps around the <img> — without this, the inline maxWidth /
    // maxHeight let the image's intrinsic size inflate the cell.
    // :has() targets only the div that actually contains the thumbnail,
    // avoiding the SwitchTransition placeholder wrapper.
    .mx_MImageBody_thumbnail_container > div:has(> .mx_MImageBody_thumbnail) {
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
    }

    .mx_MImageBody_thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
        max-width: unset !important;
        max-height: unset !important;
        display: block;
    }

    > .mx_MImageBody > a {
        display: block;
        width: 100%;
        height: 100%;
    }
}

// -------------------------------------------------------------------------
// "+N more" overlay on the last visible cell
// -------------------------------------------------------------------------

.mx_MImageGallery_overflow {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.5px;

    &:hover {
        background: rgba(0, 0, 0, 0.45);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused, #0dbd8b);
        outline-offset: -2px;
    }
}

// -------------------------------------------------------------------------
// Gallery EventTile wrapper
// -------------------------------------------------------------------------

.mx_EventTile_gallery {
    margin-top: 4px;
    margin-bottom: 4px;

    // Group (default) layout
    &[data-layout="group"] {
        padding-left: 64px;
        padding-right: 8px;
    }

    // Bubble layout
    &[data-layout="bubble"] {
        --cornerRadius: 12px;
        --gutterSize: 11px;

        // No max-width / margin-inline: auto here — the <li> must be full-width
        // (same as standard EventBubbleTile) so that mx_EventTile_msgOption's
        // read-receipt anchors to the full-width <li> edge, producing the same
        // visual position as text-bubble receipts.  Alignment (left/right) is
        // handled by mx_EventTile_gallery_lineWrapper below, which mirrors the
        // role of mx_EventTile_line in the standard tile.
        margin-inline-start: var(--EventTile_bubble-margin-inline-start, 49px);
        margin-inline-end: var(--EventTile_bubble-margin-inline-end, 60px);
        position: relative;

        // Hover highlight — same visual as EventBubbleTile but without
        // z-index: -1 which breaks inside overflow:hidden stacking contexts.
        &::before {
            content: "";
            position: absolute;
            top: -1px;
            bottom: -1px;
            left: calc(-1 * var(--EventTile_bubble-margin-inline-start, 49px));
            right: calc(-1 * var(--EventTile_bubble-margin-inline-end, 60px));
            border-radius: 4px;
            pointer-events: none;
        }

        &:hover::before {
            background: $eventbubble-bg-hover;
            z-index: 0;
        }

        // Bubble must sit above the hover highlight.
        // Also the positioning ancestor for .mx_GalleryActionBar.
        .mx_EventTile_gallery_bubble {
            position: relative;
            z-index: 1;
            background: $eventbubble-others-bg;
            border-radius: var(--cornerRadius);
            overflow: hidden;
            // Padding between images and bubble border
            padding: var(--gutterSize);
            // Cap the content area to match the grid width (500px)
            // so captions wrap instead of inflating the bubble.
            max-width: 500px;
            width: fit-content;
            // Match the negative inline margins that standard EventBubbleTile
            // applies to .mx_EventTile_line so the bubble visually starts
            // behind the avatar instead of clearing it.
            margin-inline-start: var(--EventTile_bubble_line-margin-inline-start, -9px);
            margin-inline-end: var(--EventTile_bubble_line-margin-inline-end, -12px);

            // The bubble border-radius clips corners; strip the grid's own
            .mx_MImageGallery_grid {
                border-radius: 0;
            }

            // Single image: neutralise MImageBody inline sizing so it
            // respects the bubble width instead of inflating it.
            .mx_MImageBody_single {
                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    aspect-ratio: unset !important;
                }

                .mx_MImageBody_thumbnail {
                    width: 100%;
                    height: auto;
                    object-fit: contain;
                    max-width: 100%;
                    max-height: unset;
                    display: block;
                }
            }

            // Multi-image grid: cells handle their own sizing via
            // aspect-ratio on .mx_MImageGallery_cell, so just
            // kill inline sizes on MImageBody within cells.
            .mx_MImageGallery_cell {
                .mx_MImageBody,
                .mx_MImageBody > a {
                    margin: 0;
                    padding: 0;
                    max-width: unset !important;
                    max-height: unset !important;
                    height: 100%;
                    width: 100%;
                }

                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    width: 100% !important;
                    height: 100% !important;
                    aspect-ratio: unset !important;
                }
            }

            // Caption: small gap between grid and text so the bubble
            // stays close in size to the no-caption variant.
            .mx_EventTile_galleryCaption {
                padding-top: 4px;
            }
        }

        // Own messages: right-align the lineWrapper + self background
        &[data-self="true"] {
            .mx_EventTile_gallery_lineWrapper {
                // Mirrors margin-inline-start: auto on mx_EventTile_line for
                // own messages in standard EventBubbleTile — pushes the narrow
                // wrapper (and thus the bubble) to the right edge of the <li>.
                margin-inline-start: auto;
            }

            .mx_EventTile_gallery_bubble {
                background: $eventbubble-self-bg;
            }

            .mx_EventTile_galleryCaption {
                text-align: right;
            }
        }

        // Others' messages: wrapper is left-aligned by default — no extra rule.

        // DM (hideSender=true): keep the sender-name row taking layout space
        // so the bubble still drops below the avatar's vertical centre, but
        // hide the name itself. We deliberately diverge from upstream's
        // `mx_EventTile_noSender` behaviour (which collapses the row + bumps
        // the avatar to top: -19px) so the DM gallery bubble aligns the same
        // way as a group bubble. `visibility: hidden` preserves the box
        // dimensions; `display: none` would collapse them.
        &[data-hide-sender="true"] > .mx_DisambiguatedProfile {
            visibility: hidden;
        }
    }
}

.mx_EventTile_galleryCaption {
    font-size: $font-14px;
    line-height: $font-20px;
    color: $primary-content;
    word-break: break-word;
}

// -------------------------------------------------------------------------
// Reactions row inside a gallery tile
// -------------------------------------------------------------------------

.mx_EventTile_gallery > .mx_EventTile_footer {
    position: relative;
    z-index: 1;
    padding: 0 var(--gutterSize, 11px);
}

// -------------------------------------------------------------------------
// Read receipts — no custom overrides needed
// -------------------------------------------------------------------------
// mx_EventTile_msgOption is a direct child of the gallery <li>, the same
// structural relationship as standard EventTile in Room/default rendering.
// The global rule in _EventTile.pcss:
//   .mx_EventTile[data-layout="bubble"] .mx_EventTile_msgOption .mx_ReadReceiptGroup
//     { position: absolute; inset-inline-end: -78px; inset-block-end: -3px; }
// applies here unchanged — the <li> is the containing block for the
// absolute receipt, matching the behaviour of text bubbles exactly.

// -------------------------------------------------------------------------
// lineWrapper — mirrors mx_EventTile_line in standard EventBubbleTile
// -------------------------------------------------------------------------
// This narrow, positioned container wraps the bubble + action bar so that:
//   • mx_MessageActionBar's `inset-inline-start: calc(100% - …)` from
//     _EventBubbleTile.pcss [data-self="false"] anchors to the wrapper's
//     right edge (≈ bubble right edge) rather than to the full-width <li>.
//   • mx_EventTile_msgOption stays OUTSIDE this wrapper as a direct child
//     of the <li>, so ReadReceiptGroup's `inset-inline-end: -78px` anchors
//     to the full-width <li> — identical to standard text-bubble receipts.

.mx_EventTile_gallery_lineWrapper {
    position: relative;
    width: fit-content;
}

// -------------------------------------------------------------------------
// Thread-panel receipt position correction
// -------------------------------------------------------------------------
// In thread view the gallery <li> is full-width with margin-inline: 36px
// each side (applied by the .mx_ThreadView .mx_EventTile[data-layout="bubble"]
// rule in _EventTile.pcss).  The standard receipt rule in _EventTile.pcss:
//   .mx_EventTile[data-layout="bubble"] .mx_EventTile_msgOption .mx_ReadReceiptGroup
//     { inset-inline-end: -78px; }   ← specificity (0,4,0)
// loads after _MImageGallery.pcss and wins at equal specificity, so -78px
// always applies and the receipt lands off-screen.
//
// Adding [data-layout="bubble"] raises this selector to (0,5,0) so it beats
// _EventTile.pcss.  The formula -36px + 6px = -30px places the receipt's
// right edge 6px inside the thread panel's right border (all avatars visible).
.mx_ThreadView .mx_EventTile_gallery[data-layout="bubble"] > .mx_EventTile_msgOption .mx_ReadReceiptGroup {
    inset-inline-end: calc(-1 * var(--BaseCard_EventTile-spacing-inline, 36px) + 6px);
}
