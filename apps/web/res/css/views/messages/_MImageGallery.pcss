/*
 * _MImageGallery.pcss
 *
 * Styles for the image gallery grid and the bubble wrapper used
 * by ImageGalleryGrouper (both single images and multi-image grids).
 */

// The gallery sits inside a normal EventTile content area.
.mx_MImageGallery {
    max-width: 324px;
    width: 100%;
}

// -------------------------------------------------------------------------
// Grid container
// -------------------------------------------------------------------------

.mx_MImageGallery_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    border-radius: 8px;
    overflow: hidden;

    // Expanded mode: let rows grow naturally.
    &--expanded {
        grid-template-rows: unset;
        grid-auto-rows: 1fr;

        .mx_MImageGallery_cell {
            aspect-ratio: 1 / 1;
        }
    }
}

// -------------------------------------------------------------------------
// Individual cell
// -------------------------------------------------------------------------

.mx_MImageGallery_cell {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    // Each cell is square so the grid has consistent proportions
    aspect-ratio: 1 / 1;

    .mx_MImageBody {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .mx_MImageBody_thumbnail_container {
        max-width: 100% !important;
        max-height: 100% !important;
        width: 100% !important;
        height: 100% !important;
        aspect-ratio: unset !important;
    }

    .mx_MImageBody_thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
        max-width: unset;
        max-height: unset;
        display: block;
    }

    > .mx_MImageBody > a {
        display: block;
        width: 100%;
        height: 100%;
    }
}

// -------------------------------------------------------------------------
// "+N more" overlay on the last visible cell
// -------------------------------------------------------------------------

.mx_MImageGallery_overflow {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.5px;

    &:hover {
        background: rgba(0, 0, 0, 0.45);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused, #0dbd8b);
        outline-offset: -2px;
    }
}

// -------------------------------------------------------------------------
// Gallery EventTile wrapper
// -------------------------------------------------------------------------

.mx_EventTile_gallery {
    margin-top: 4px;
    margin-bottom: 4px;

    // Group (default) layout
    &[data-layout="group"] {
        padding-left: 64px;
        padding-right: 8px;
    }

    // Bubble layout
    &[data-layout="bubble"] {
        --cornerRadius: 12px;
        --gutterSize: 11px;

        max-width: 70%;
        margin-inline-start: var(--EventTile_bubble-margin-inline-start, 49px);
        margin-inline-end: var(--EventTile_bubble-margin-inline-end, 60px);

        .mx_EventTile_gallery_bubble {
            background: $eventbubble-others-bg;
            border-radius: var(--cornerRadius);
            overflow: hidden;
            // Padding between images and bubble border
            padding: var(--gutterSize);

            .mx_MImageGallery {
                max-width: 100%;
            }

            // The bubble border-radius clips corners; strip the grid's own
            .mx_MImageGallery_grid {
                border-radius: 0;
            }

            // Single image: neutralise MImageBody inline sizing so it
            // respects the bubble width instead of inflating it.
            .mx_MImageBody_single {
                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    aspect-ratio: unset !important;
                }

                .mx_MImageBody_thumbnail {
                    width: 100%;
                    height: auto;
                    object-fit: contain;
                    max-width: 100%;
                    max-height: unset;
                    display: block;
                }
            }

            // Multi-image grid: cells handle their own sizing via
            // aspect-ratio on .mx_MImageGallery_cell, so just
            // kill inline sizes on MImageBody within cells.
            .mx_MImageGallery_cell {
                .mx_MImageBody,
                .mx_MImageBody > a {
                    margin: 0;
                    padding: 0;
                    max-width: unset !important;
                    max-height: unset !important;
                    height: 100%;
                    width: 100%;
                }

                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    width: 100% !important;
                    height: 100% !important;
                    aspect-ratio: unset !important;
                }
            }

            // Caption: separated from images above
            .mx_EventTile_galleryCaption {
                padding-top: var(--gutterSize);
            }
        }

        // Own messages: right-aligned + self background
        &[data-self="true"] {
            margin-inline-start: auto;

            .mx_EventTile_gallery_bubble {
                background: $eventbubble-self-bg;
            }

            .mx_EventTile_galleryCaption {
                text-align: right;
            }
        }

        // Others' messages: left-aligned
        &[data-self="false"] {
            margin-inline-end: auto;
        }
    }
}

.mx_EventTile_galleryCaption {
    font-size: $font-14px;
    line-height: $font-20px;
    color: $primary-content;
    word-break: break-word;
}
