/*
 * _MImageGallery.pcss
 *
 * Styles for the image gallery grid and the bubble wrapper used
 * by ImageGalleryGrouper (both single images and multi-image grids).
 */

// The gallery sits inside a normal EventTile content area.
// Width is driven by the fixed-pixel grid columns set in the component;
// max-width prevents overflow on narrow viewports.
.mx_MImageGallery {
    max-width: 500px;
    overflow: hidden;
}

// -------------------------------------------------------------------------
// Grid container
// -------------------------------------------------------------------------

.mx_MImageGallery_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    border-radius: 8px;
    overflow: hidden;

    // Expanded mode: let rows grow naturally.
    &--expanded {
        grid-template-rows: unset;
        grid-auto-rows: 1fr;

        .mx_MImageGallery_cell {
            aspect-ratio: 1 / 1;
        }
    }
}

// -------------------------------------------------------------------------
// Individual cell
// -------------------------------------------------------------------------

.mx_MImageGallery_cell {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    // Each cell is square so the grid has consistent proportions
    aspect-ratio: 1 / 1;

    .mx_MImageBody {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .mx_MImageBody_thumbnail_container {
        max-width: 100% !important;
        max-height: 100% !important;
        width: 100% !important;
        height: 100% !important;
        aspect-ratio: unset !important;
    }

    // Override the inner sizing <div style={sizing}> that MImageBody
    // wraps around the <img> — without this, the inline maxWidth /
    // maxHeight let the image's intrinsic size inflate the cell.
    // :has() targets only the div that actually contains the thumbnail,
    // avoiding the SwitchTransition placeholder wrapper.
    .mx_MImageBody_thumbnail_container > div:has(> .mx_MImageBody_thumbnail) {
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        max-height: 100% !important;
    }

    .mx_MImageBody_thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
        max-width: unset !important;
        max-height: unset !important;
        display: block;
    }

    > .mx_MImageBody > a {
        display: block;
        width: 100%;
        height: 100%;
    }
}

// -------------------------------------------------------------------------
// "+N more" overlay on the last visible cell
// -------------------------------------------------------------------------

.mx_MImageGallery_overflow {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.5px;

    &:hover {
        background: rgba(0, 0, 0, 0.45);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused, #0dbd8b);
        outline-offset: -2px;
    }
}

// -------------------------------------------------------------------------
// Gallery EventTile wrapper
// -------------------------------------------------------------------------

.mx_EventTile_gallery {
    margin-top: 4px;
    margin-bottom: 4px;

    // Group (default) layout
    &[data-layout="group"] {
        padding-left: 64px;
        padding-right: 8px;
    }

    // Bubble layout
    &[data-layout="bubble"] {
        --cornerRadius: 12px;
        --gutterSize: 11px;

        max-width: 70%;
        margin-inline-start: var(--EventTile_bubble-margin-inline-start, 49px);
        margin-inline-end: var(--EventTile_bubble-margin-inline-end, 60px);
        position: relative;

        // Hover highlight — same visual as EventBubbleTile but without
        // z-index: -1 which breaks inside overflow:hidden stacking contexts.
        &::before {
            content: "";
            position: absolute;
            top: -1px;
            bottom: -1px;
            left: calc(-1 * var(--EventTile_bubble-margin-inline-start, 49px));
            right: calc(-1 * var(--EventTile_bubble-margin-inline-end, 60px));
            border-radius: 4px;
            pointer-events: none;
        }

        &:hover::before {
            background: $eventbubble-bg-hover;
            z-index: 0;
        }

        // Bubble must sit above the hover highlight.
        // Also the positioning ancestor for .mx_GalleryActionBar.
        .mx_EventTile_gallery_bubble {
            position: relative;
            z-index: 1;
            background: $eventbubble-others-bg;
            border-radius: var(--cornerRadius);
            overflow: hidden;
            // Padding between images and bubble border
            padding: var(--gutterSize);
            // Cap the content area to match the grid width (500px)
            // so captions wrap instead of inflating the bubble.
            max-width: 500px;
            width: fit-content;
            // Match the negative inline margins that standard EventBubbleTile
            // applies to .mx_EventTile_line so the bubble visually starts
            // behind the avatar instead of clearing it.
            margin-inline-start: var(--EventTile_bubble_line-margin-inline-start, -9px);
            margin-inline-end: var(--EventTile_bubble_line-margin-inline-end, -12px);

            // The bubble border-radius clips corners; strip the grid's own
            .mx_MImageGallery_grid {
                border-radius: 0;
            }

            // Single image: neutralise MImageBody inline sizing so it
            // respects the bubble width instead of inflating it.
            .mx_MImageBody_single {
                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    aspect-ratio: unset !important;
                }

                .mx_MImageBody_thumbnail {
                    width: 100%;
                    height: auto;
                    object-fit: contain;
                    max-width: 100%;
                    max-height: unset;
                    display: block;
                }
            }

            // Multi-image grid: cells handle their own sizing via
            // aspect-ratio on .mx_MImageGallery_cell, so just
            // kill inline sizes on MImageBody within cells.
            .mx_MImageGallery_cell {
                .mx_MImageBody,
                .mx_MImageBody > a {
                    margin: 0;
                    padding: 0;
                    max-width: unset !important;
                    max-height: unset !important;
                    height: 100%;
                    width: 100%;
                }

                .mx_MImageBody_thumbnail_container {
                    max-width: 100% !important;
                    max-height: 100% !important;
                    width: 100% !important;
                    height: 100% !important;
                    aspect-ratio: unset !important;
                }
            }

            // Caption: small gap between grid and text so the bubble
            // stays close in size to the no-caption variant.
            .mx_EventTile_galleryCaption {
                padding-top: 4px;
            }
        }

        // Own messages: right-aligned + self background
        &[data-self="true"] {
            margin-inline-start: auto;

            .mx_EventTile_gallery_bubble {
                background: $eventbubble-self-bg;
            }

            .mx_EventTile_galleryCaption {
                text-align: right;
            }
        }

        // Others' messages: left-aligned
        &[data-self="false"] {
            margin-inline-end: auto;
        }

        // DM (hideSender=true): keep the sender-name row taking layout space
        // so the bubble still drops below the avatar's vertical centre, but
        // hide the name itself. We deliberately diverge from upstream's
        // `mx_EventTile_noSender` behaviour (which collapses the row + bumps
        // the avatar to top: -19px) so the DM gallery bubble aligns the same
        // way as a group bubble. `visibility: hidden` preserves the box
        // dimensions; `display: none` would collapse them.
        &[data-hide-sender="true"] > .mx_DisambiguatedProfile {
            visibility: hidden;
        }
    }
}

.mx_EventTile_galleryCaption {
    font-size: $font-14px;
    line-height: $font-20px;
    color: $primary-content;
    word-break: break-word;
}

// -------------------------------------------------------------------------
// Reactions row inside a gallery tile
// -------------------------------------------------------------------------

.mx_EventTile_gallery > .mx_EventTile_footer {
    position: relative;
    z-index: 1;
    padding: 0 var(--gutterSize, 11px);
}

// -------------------------------------------------------------------------
// Read receipts (msgOption) row inside a gallery tile
// -------------------------------------------------------------------------

.mx_EventTile_gallery > .mx_EventTile_msgOption {
    position: relative;
    z-index: 2;
    margin-top: 2px;
    // Reset the floating 90px-wide hack used by the standard EventTile
    // group layout — we want the receipts to sit directly under the
    // bubble and align with its edges.
    float: none;
    width: auto;
    height: auto;

    .mx_ReadReceiptGroup {
        position: relative;
        inset: auto;
    }
}

// _EventTile.pcss carries a (0,4,0)-specificity rule that forces
// .mx_ReadReceiptGroup inside any .mx_EventTile[data-layout="bubble"]
// to position: absolute with inset-inline-end: -78px, pushing it 78px
// past the bubble's right edge and off-screen in the narrow thread panel.
// Our selector above is only (0,3,0) and loses.  Add a (0,5,0) rule that
// explicitly resets every inset logical/physical property so the receipt
// stays in its natural (relative) position under the bubble.
.mx_EventTile.mx_EventTile_gallery[data-layout="bubble"] > .mx_EventTile_msgOption {
    .mx_ReadReceiptGroup {
        position: relative;
        inset-block-start: auto;
        inset-block-end: auto;
        inset-inline-start: auto;
        inset-inline-end: auto;
    }
}

.mx_EventTile_gallery[data-self="true"] > .mx_EventTile_msgOption {
    text-align: right;
}

.mx_EventTile_gallery[data-self="false"] > .mx_EventTile_msgOption {
    text-align: left;
}

// -------------------------------------------------------------------------
// Standard action bar positioning inside gallery tiles
// -------------------------------------------------------------------------

.mx_EventTile_gallery .mx_MessageActionBar {
    right: 0;
}

// In thread view, _EventTile.pcss applies:
//   .mx_ThreadView .mx_EventTile[data-layout="bubble"] { margin-inline: 36px }
// with (0,3,0) specificity, which overrides our (0,3,0) gallery rule that
// sets margin-inline-end: auto for others' messages (last-write wins and
// _EventTile.pcss loads after us).  Without the auto right margin, the
// gallery <li> stretches to the full thread-panel width as a flex item.
// The action bar is then positioned at inset-inline-start: calc(100%…)
// relative to that full-width <li>, placing it far to the right of the
// left-aligned bubble — visually the "context menu/action bar offset" the
// user reports.  Own messages are unaffected because align-items: flex-end
// on the thread container right-aligns the bubble to match the right edge.
// Bump specificity to (0,5,0) so margin-inline-end: auto is preserved in
// thread view, keeping the <li> shrunk to content-width (= bubble width).
.mx_EventTile.mx_EventTile_gallery[data-layout="bubble"][data-self="false"] {
    margin-inline-end: auto;
}
